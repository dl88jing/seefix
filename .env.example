# Copy to .env.local (gitignored). Placeholders only; never commit real values.

# Meta Model API key (dev.meta.ai). MODEL_API_KEY is accepted as a fallback.
META_API_KEY=

# Muse Glimmer safety gate on Modal (URL printed by `modal deploy modal/glimmer_gate.py`)
GLIMMER_URL=
# Same value as GLIMMER_API_KEY in the Modal secret "seefix-glimmer"
GLIMMER_API_KEY=

# Optional overrides
# META_BASE_URL=https://api.meta.ai/v1
# META_SPARK_MODEL=muse-spark-1.3
# META_SAM_MODEL=sam-3.1
# META_IMAGE_MODEL=muse-image-1.0
# GLIMMER_MODEL=muse-glimmer
