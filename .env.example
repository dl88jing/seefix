# Copy to .env.local (gitignored). Placeholders only; never commit real values.

# Preferred Muse Spark path: Meta Muse Spark Open via Baseten (OpenAI-compatible).
# When BASETEN_API_KEY is set, /api/identify uses it and BASETEN_MODEL.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Meta Model API key (dev.meta.ai) — still required for SAM 3.1 and Muse Image.
# Also used as a Spark fallback when BASETEN_API_KEY is unset. MODEL_API_KEY accepted.
META_API_KEY=

# Muse Glimmer safety gate on Modal (URL printed by `modal deploy modal/glimmer_gate.py`)
GLIMMER_URL=
# Rate limiter for /api/safety and /api/identify (web URL of the `quota` function)
GLIMMER_QUOTA_URL=
# Same value as GLIMMER_API_KEY in the Modal secret "seefix-glimmer"
GLIMMER_API_KEY=

# Optional overrides
# META_BASE_URL=https://api.meta.ai/v1
# META_SPARK_MODEL=muse-spark-1.3
# META_SAM_MODEL=sam-3.1
# META_IMAGE_MODEL=muse-image-1.0
# GLIMMER_MODEL=muse-glimmer
# SPARK_PER_IP_PER_HOUR=20
# SPARK_GLOBAL_PER_DAY=200
# SAFETY_PER_IP_PER_HOUR=10
# SAFETY_GLOBAL_PER_DAY=100
